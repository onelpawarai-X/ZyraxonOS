#!/usr/bin/env bash
# ZyraxonOS custom tool dispatcher.
# Every "zx-*" command in the ZyraxonOS toolset is a symlink to this script.
# Each subcommand wraps real Linux tooling in a simple interface.
set -u
NAME="$(basename "$0")"
if [ "$NAME" = "zx" ]; then
  CMD="${1:-help}"; shift 2>/dev/null || true
else
  CMD="${NAME#zx-}"
fi

G='\033[1;36m'; Y='\033[1;33m'; N='\033[0m'
hdr()  { printf "${G}✦ %s${N}\n" "$*"; }
warn() { printf "${Y}! %s${N}\n" "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || { warn "missing tool: $1"; return 1; }; }

case "$CMD" in

# ---------------- system ----------------
sysinfo)
  hdr "ZyraxonOS system summary"
  echo "OS      : $(grep PRETTY_NAME /etc/os-release | cut -d= -f2- | tr -d '\"')"
  echo "Kernel  : $(uname -r) ($(uname -m))"
  echo "Host    : $(cat /etc/hostname 2>/dev/null)"
  echo "Uptime  : $(uptime -p 2>/dev/null)"
  echo "CPU     : $(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ //')"
  echo "Cores   : $(nproc)"
  echo "Memory  : $(free -h | awk '/Mem:/{print $3" / "$2}')"
  echo "Disk    : $(df -h / | awk 'NR==2{print $3" / "$2" ("$5")"}')"
  echo "GPU     : $(lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -1 | cut -d: -f3- | sed 's/^ //')"
  echo "Network : $(ip -brief addr show 2>/dev/null | awk '$1!="lo"{printf "%s=%s ", $1, $3}')"
  ;;
neofetch)
  printf "${G}"
  printf '        /\\          zyraxon@zyraxonos\n'
  printf '       /  \\         ------------------\n'
  printf '      / /\\ \\        OS:      %s\n' "$(grep PRETTY_NAME /etc/os-release | cut -d= -f2- | tr -d '"')"
  printf '     / /  \\ \\       Kernel:  %s\n' "$(uname -r)"
  printf '    / /    \\ \\      Shell:   zyraxon-shell\n'
  printf '   / /______\\ \\     DE:      Zyraxon Glass\n'
  printf '  /__________\\ \\    WM:      Cage (Wayland)\n'
  printf ' /____________\\ \\   Theme:   Glass / Translucent\n'
  printf '/______________\\ \\  AI:      ZYRAXON AI (built in)\n'
  printf "${N}"
  ;;
glass-switch)
  f=/etc/zyraxon/glass.conf; mkdir -p /etc/zyraxon
  cur="$(cat "$f" 2>/dev/null || echo 26)"
  case "${1:-cycle}" in
    low) v=8;; med) v=18;; high) v=26;; ultra) v=40;;
    cycle) v=$(( cur >= 40 ? 8 : cur + 8 ));;
    *) v="${1:-26}";;
  esac
  echo "$v" > "$f"
  hdr "glass blur = ${v}px (reload the shell to apply)"
  ;;
wallpaper)     hdr "aurora wallpaper: ${1:-cycle}"; echo "${1:-aurora}" > /etc/zyraxon/wallpaper 2>/dev/null || true ;;
update)        hdr "checking for ZyraxonOS + ZYRAXON AI updates"; zyraxon-ota check ;;
update-apply)  hdr "applying the newest ZyraxonOS patch (no reinstall)"; zyraxon-ota patch ;;
update-full)   hdr "updating ZyraxonOS from the full image"; zyraxon-ota full ;;
update-auto)   hdr "automatic ZyraxonOS update"; zyraxon-ota auto ;;
update-status)
  hdr "update status"
  echo "OS : $(grep PRETTY_NAME /etc/os-release | cut -d= -f2-)"
  echo "AI : $(cat /opt/zyraxon/.installed-version 2>/dev/null || echo 'not installed')"
  echo "    last OTA: $(cat /var/lib/zyraxon/.os-version 2>/dev/null || echo 'none')"
  ;;
ai)            command -v zyraxon >/dev/null 2>&1 && exec zyraxon "$@" || warn "ZYRAXON AI binary not found" ;;
ai-status)
  hdr "ZYRAXON AI status"
  if command -v zyraxon >/dev/null 2>&1 || [ -d /opt/ZYRAXON ]; then
    echo "installed: yes"; echo "version  : $(cat /opt/zyraxon/.installed-version 2>/dev/null || echo unknown)"
  else echo "installed: NO (run zx-ai-guard)"; fi
  ;;
ai-guard)      hdr "re-pinning ZYRAXON AI"; /opt/zyraxon/zyraxon-guard.sh ;;

# ---------------- wifi ----------------
wifi-scan)
  hdr "scanning Wi-Fi networks"
  if command -v nmcli >/dev/null 2>&1; then nmcli -f SSID,SIGNAL,CHAN,SECURITY device wifi list
  elif command -v iw >/dev/null 2>&1; then iw dev "$(iw dev | awk '/Interface/{print $2;exit}')" scan 2>/dev/null | grep -E "SSID|signal" | head -40
  else warn "no wifi tooling"; fi ;;
wifi-connect)  need nmcli || exit 1; hdr "connecting to ${1:?usage: zx-wifi-connect SSID [password]}"; nmcli device wifi connect "$1" password "${2:-}" ;;
wifi-hotspot)  need nmcli || exit 1; hdr "starting hotspot ${1:-ZyraxonOS}"; nmcli device wifi hotspot ssid "${1:-ZyraxonOS}" password "${2:-zyraxon1234}" ;;
wifi-monitor)  need airmon-ng || exit 1; hdr "enabling monitor mode"; airmon-ng start "${1:-wlan0}" ;;
wifi-deauth)   need aireplay-ng || exit 1; hdr "deauth test (authorised networks only)"; echo "usage: aireplay-ng --deauth 10 -a <BSSID> <iface>" ;;
wifi-crack)    need airodump-ng || exit 1; hdr "handshake capture workflow"; echo "1) zx-wifi-monitor  2) airodump-ng -w cap <iface>  3) aireplay-ng --deauth" ;;

# ---------------- network ----------------
net-scan)      need nmap || exit 1; hdr "LAN discovery"; nmap -sn "${1:-$(ip route | awk '/default/{print $3}')/24}" ;;
net-speed)     if command -v speedtest-cli >/dev/null 2>&1; then hdr "speed test"; speedtest-cli; else need iperf3 || exit 1; hdr "iperf3 to ${1:-1.1.1.1}"; iperf3 -c "${1:-1.1.1.1}"; fi ;;
net-trace)     hdr "trace to ${1:-1.1.1.1}"; traceroute "${1:-1.1.1.1}" 2>/dev/null || tracepath "${1:-1.1.1.1}" ;;
net-dns)       hdr "DNS for ${1:-github.com}"; (dig +short "$1" 2>/dev/null || nslookup "$1") | head -20 ;;
net-ports)     need nmap || exit 1; hdr "port scan ${1:?host}"; nmap -sV -T4 "$1" ;;
net-capture)   need tcpdump || exit 1; hdr "capture ${1:-any} -> /tmp/cap.pcap"; timeout 20 tcpdump -i "${1:-any}" -w /tmp/cap.pcap ;;
net-firewall)  hdr "firewall status"; nft list ruleset 2>/dev/null || ufw status verbose 2>/dev/null || warn "no firewall backend" ;;

# ---------------- security ----------------
sec-audit)     if command -v lynis >/dev/null 2>&1; then hdr "lynis audit"; lynis audit system --quick; else hdr "basic audit"; zx-sysinfo; fi ;;
sec-rootkit)   hdr "rootkit scan"; rkhunter --check --sk 2>/dev/null || chkrootkit 2>/dev/null | tail -30 || warn "install rkhunter or chkrootkit" ;;
sec-antivirus) need clamscan || exit 1; hdr "malware scan ${1:-/home}"; clamscan -r "${1:-/home}" 2>/dev/null | tail -20 ;;
sec-passwd)    hdr "password hash"; printf '%s' "${1:-}" | sha256sum ;;
sec-encrypt)   need gpg || exit 1; hdr "encrypting ${1:?file}"; gpg -c "$1" ;;
sec-backup)    hdr "backup ${1:-/home} -> ${2:-/tmp}"; tar czf "${2:-/tmp}/zyraxon-backup-$(date +%s).tgz" "${1:-/home}" 2>/dev/null ;;

# ---------------- dev ----------------
dev-git)       need git || exit 1; hdr "git status"; git status -sb 2>/dev/null || echo "not a git repo" ;;
dev-build)     hdr "build helper"; if [ -f Makefile ]; then make; elif [ -f package.json ]; then npm run build; else warn "no build system found"; fi ;;
dev-env)       hdr "toolchain"; for t in gcc g++ clang python3 node go rustc java; do printf "%-8s %s\n" "$t" "$(command -v $t || echo '-')"; done ;;
dev-docker)    hdr "containers"; docker ps 2>/dev/null || podman ps 2>/dev/null || warn "no container runtime" ;;
dev-kube)      need kubectl || exit 1; hdr "kubernetes"; kubectl get nodes 2>/dev/null || echo "no cluster" ;;

# ---------------- packages ----------------
pkg-install)   need apt-get || exit 1; hdr "install $*"; DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" ;;
pkg-search)    hdr "search $*"; apt-cache search "$*" | head -30 ;;
pkg-clean)     hdr "reclaiming space"; apt-get clean; apt-get autoremove -y ;;

# ---------------- files ----------------
file-search)   if command -v fd >/dev/null 2>&1; then hdr "search $*"; fd "$@"; else hdr "search $*"; find / -iname "*$1*" 2>/dev/null | head -40; fi ;;
file-big)      hdr "largest files under ${1:-/}"; du -ah "${1:-/}" 2>/dev/null | sort -rh | head -20 ;;
file-dedupe)   need fdupes || exit 1; hdr "duplicates in ${1:-/home}"; fdupes -r "${1:-/home}" ;;
file-recover)  hdr "recovery helper"; echo "run: testdisk ${1:-/dev/sdX}" ;;

# ---------------- hardware ----------------
disk-health)   need smartctl || exit 1; hdr "SMART report"; for d in /dev/sd? /dev/nvme?n?; do [ -b "$d" ] && smartctl -H "$d"; done ;;
disk-bench)    hdr "disk benchmark"; dd if=/dev/zero of=/tmp/zxbench bs=1M count=512 conv=fdatasync 2>&1 | tail -1; rm -f /tmp/zxbench ;;
thermal)       hdr "temperatures"; sensors 2>/dev/null || cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null ;;
battery)       hdr "power"; upower -i "$(upower -e 2>/dev/null | grep BAT | head -1)" 2>/dev/null || cat /sys/class/power_supply/BAT*/capacity 2>/dev/null || echo "no battery (desktop)" ;;
process-kill)  hdr "processes matching ${1:?name}"; pgrep -af "$1"; echo "kill with: pkill -f $1" ;;
service)       need systemctl || exit 1; hdr "services"; systemctl --failed --no-pager; systemctl list-units --type=service --state=running --no-pager | head -20 ;;
log-view)      hdr "recent logs"; journalctl -n 40 --no-pager 2>/dev/null || tail -40 /var/log/syslog 2>/dev/null ;;

# ---------------- desktop ----------------
screenshot)    hdr "screenshot ${1:-/tmp/shot.png}"; if command -v grim >/dev/null 2>&1; then grim "${1:-/tmp/shot.png}"; else echo "press PrtSc inside the glass shell"; fi ;;
screen-record) hdr "record ${1:-/tmp/rec.mp4}"; echo "use: wf-recorder -f ${1:-/tmp/rec.mp4}" ;;
clip)          hdr "clipboard"; (command -v wl-paste >/dev/null 2>&1 && wl-paste) || echo "clipboard helper" ;;
theme)         hdr "glass theme: ${1:-aurora}"; echo "${1:-aurora}" > /etc/zyraxon/theme 2>/dev/null || true ;;

help|*)
  hdr "ZyraxonOS tools (zx-*)"
  cat <<'EOF'
system    : zx-sysinfo zx-neofetch zx-glass-switch zx-wallpaper zx-update
            zx-update-apply zx-update-full zx-update-status
            zx-ai zx-ai-status zx-ai-guard
wifi      : zx-wifi-scan zx-wifi-connect zx-wifi-hotspot zx-wifi-monitor
            zx-wifi-deauth zx-wifi-crack
network   : zx-net-scan zx-net-speed zx-net-trace zx-net-dns zx-net-ports
            zx-net-capture zx-net-firewall
security  : zx-sec-audit zx-sec-rootkit zx-sec-antivirus zx-sec-passwd
            zx-sec-encrypt zx-sec-backup
dev       : zx-dev-git zx-dev-build zx-dev-env zx-dev-docker zx-dev-kube
packages  : zx-pkg-install zx-pkg-search zx-pkg-clean
files     : zx-file-search zx-file-big zx-file-dedupe zx-file-recover
hardware  : zx-disk-health zx-disk-bench zx-thermal zx-battery
            zx-process-kill zx-service zx-log-view
desktop   : zx-screenshot zx-screen-record zx-clip zx-theme
EOF
  ;;
esac
