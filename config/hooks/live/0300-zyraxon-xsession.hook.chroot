#!/bin/bash
# ============================================================
# Deterministic XFCE session for ZyraxonOS.
# startxfce4 relies on a session bus being present; in a bare
# systemd unit it is not, so the panel/desktop never come up.
# We run the whole session inside its own dbus session bus.
# ============================================================
set -uo pipefail

cat > /usr/local/bin/zyraxon-xsession <<'EOF'
#!/bin/bash
# ZyraxonOS XFCE session.
export XDG_RUNTIME_DIR=/run/user/1000
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XDG_CONFIG_DIRS=/etc/xdg
export XDG_DATA_DIRS=/usr/share:/usr/local/share
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"

# start a session bus and run the real XFCE session inside it
exec dbus-run-session -- startxfce4
EOF
chmod 0755 /usr/local/bin/zyraxon-xsession

# make sure the compositor does not fight the software renderer
mkdir -p /etc/xdg/xfce4
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="true"/>
    <property name="theme" type="string" value="ZyraxonGlass"/>
    <property name="title_font" type="string" value="Noto Sans Bold 10"/>
    <property name="button_layout" type="string" value="O|SHMC"/>
  </property>
</channel>
EOF

# the desktop: wallpaper + icons on, so the glass background shows
mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/zyraxonos/aurora.svg"/>
        </property>
      </property>
    </property>
  </property>
  <property name="desktop-icons" type="empty">
    <property name="style" type="int" value="2"/>
    <property name="icon-size" type="uint" value="48"/>
  </property>
</channel>
EOF

# autostart the pieces explicitly, in case the session does not
mkdir -p /home/zyraxon/.config/autostart
for a in xfce4-panel xfdesktop xfsettingsd xfce4-power-manager xfce4-notifyd \
         xfce4-clipman thunar; do
  case "$a" in
    xfce4-panel)  cmd="/usr/bin/xfce4-panel";;
    xfdesktop)    cmd="/usr/bin/xfdesktop";;
    xfsettingsd)  cmd="/usr/bin/xfsettingsd";;
    xfce4-power-manager) cmd="/usr/bin/xfce4-power-manager";;
    xfce4-notifyd) cmd="/usr/bin/xfce4-notifyd";;
    xfce4-clipman) cmd="/usr/bin/xfce4-clipman";;
    thunar)       cmd="/usr/bin/thunar --daemon";;
  esac
  [ -x "${cmd%% *}" ] || continue
  cat > "/home/zyraxon/.config/autostart/$a.desktop" <<EOD
[Desktop Entry]
Type=Application
Name=$a
Exec=$cmd
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
EOD
done
chown -R zyraxon:zyraxon /home/zyraxon/.config

# point the session unit at the new launcher
cat > /etc/systemd/system/zyraxon-desktop.service <<'UNIT'
[Unit]
Description=ZyraxonOS Glass Desktop (XFCE)
After=systemd-user-sessions.service dbus.service
Wants=dbus.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=zyraxon
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYReset=yes
TTYVHangup=yes
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=x11
ExecStartPre=/bin/mkdir -p /run/user/1000
ExecStartPre=/bin/chown zyraxon:zyraxon /run/user/1000
ExecStartPre=/bin/chmod 700 /run/user/1000
ExecStart=/usr/local/bin/zyraxon-xsession
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
UNIT

echo "ZyraxonOS xsessions configured."
