#!/bin/bash
# ============================================================
# ZyraxonOS — Hyprland glass session.
# Started by zyraxon-desktop.service on tty1.
# ============================================================
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=kde
export GDK_BACKEND=wayland,x11
export SDL_VIDEODRIVER=wayland
export _JAVA_AWT_WM_NONREPARENTING=1
export ZYRAXON_VIRTUAL_ENV="$HOME/.local/state/quickshell/.venv"
export PATH="$HOME/.local/bin:$PATH"

mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null

# seed the glass desktop config on first login
if [ ! -e "$HOME/.config/hypr/hyprland.lua" ]; then
  mkdir -p "$HOME/.config"
  cp -a /etc/skel/.config/. "$HOME/.config/" 2>/dev/null
fi

# Hyprland needs a clean runtime dir it can claim
rm -f "$XDG_RUNTIME_DIR/hypr"/*.sock 2>/dev/null

exec dbus-run-session -- start-hyprland
