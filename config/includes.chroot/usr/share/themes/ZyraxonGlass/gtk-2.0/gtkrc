# ZyraxonOS GTK2 fallback - glass-ish, transparent backgrounds
gtk-theme-name = "ZyraxonGlass"
gtk-font-name = "Noto Sans 10"
gtk-icon-theme-name = "Papirus-Dark"
style "zyraxon-default" {
  bg[NORMAL]    = { 0.10, 0.10, 0.18 }
  bg[SELECTED]  = { 0.49, 0.36, 1.00 }
  bg[PRELIGHT]  = { 0.20, 0.20, 0.32 }
  fg[NORMAL]    = { 1.0, 1.0, 1.0 }
  fg[PRELIGHT]  = { 1.0, 1.0, 1.0 }
  base[NORMAL]  = { 0.08, 0.08, 0.14 }
  text[NORMAL]  = { 1.0, 1.0, 1.0 }
}
class "GtkWidget" style "zyraxon-default"
